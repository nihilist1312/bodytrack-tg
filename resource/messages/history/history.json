{
    "history_screen": {
        "text": "📚 История измерений\n\nВыберите запись, чтобы просмотреть подробную информацию или изменить её.\n\nВсего записей: {}",
        "buttons": {
            "metric": {
                "text": "📅 {}",
                "callback": "history:view:{}"
            },
            "previous": {
                "text": "◀️",
                "callback": "history:previous"
            },
            "next": {
                "text": "▶️",
                "callback": "history:next"
            },
            "main_menu": {
                "text": "⬅️ Главное меню",
                "callback": "cancel"
            },
            "count": {
                "text": "{}/{}",
                "callback": "history:none"
            }
        }
    },
    "history_empty": {
        "text": "📚 История измерений\n\nУ вас пока нет сохранённых измерений.\n\nДобавьте первую запись, чтобы начать отслеживать изменения состава тела.",
        "buttons": [
            [
                {
                    "text": "➕ Добавить запись",
                    "callback": "add_metric"
                }
            ],
            [
                {
                    "text": "⬅️ Главное меню",
                    "callback": "cancel"
                }
            ]
        ]
    },
    "history_record": {
        "text": "📋 Запись от {}\n\n⚖️ Вес: {} кг\n📏 Рост: {} см\n💪 Мышечная масса: {} кг\n🔥 Жировая масса: {} кг\n\n{}",
        "buttons": [
            [
                {
                    "text": "✏️ Основные данные",
                    "callback": "add_metric:edit_main"
                },
                {
                    "text": "➕ Дополнительные данные",
                    "callback": "add_metric:select_additional"
                }
            ],
            [
                {
                    "text": "⬅️ К истории",
                    "callback": "back"
                },
                {
                    "text": "🗑️ Удалить запись",
                    "callback": "history:delete"
                }
            ]
        ]
    }
}